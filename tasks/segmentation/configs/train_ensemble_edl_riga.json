{
    "net_dir_name": "unet_riga_edl_e3",
    "architecture": "unet",
    "device_type": "cuda:1",
    "n_channels": 3,
    "n_classes": 3,
    "epochs_total": 200,
    "checkpoint_step": 20,
    "validation_step": 5,
    "nets_number": 10,

    "learn_from_scratch": true,

    "net_dir_path": "data/nets",
    "loss_func": "EDL",

    "dataset": {
        "type": "RIGA",
        "data_path": "data/RIGA/DiscRegion",
        "gt_mode": "expert3",
        "params": {
            "sets": ["Magrabia", "MESSIDOR"]
        }
    },

    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 1e-04,
            "weight_decay": 1e-04
        }
    },
    "batch_size": 4,
    "train_part": 0.75,

    "lr_scheduler": {
        "type": "StepLR",
        "parameters": {
            "gamma": 0.9,
            "step_size": 10
        }
    }
}
